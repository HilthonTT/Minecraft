<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Texture loading goes through System.Drawing, which is Windows only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <!-- Assets are loaded at runtime by a path relative to the output directory, so they have to
       travel alongside the assembly. -->
  <ItemGroup>
    <None Include="Resources\**\*" Exclude="Resources\runnable-hiero.jar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="Shaders\**\*.glsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\Screenshot 2026-08-04 230200.png" />
    <None Remove="Resources\Screenshot 2026-08-04 230200.png" />
  </ItemGroup>

</Project>
